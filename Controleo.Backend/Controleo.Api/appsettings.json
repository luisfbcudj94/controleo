{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CosmosStorage": {
    "Endpoint": "TU_COSMOS_ENDPOINT",
    "Key": "TU_COSMOS_KEY",
    "DatabaseName": "controleo",
    "ExpensesContainerName": "expenses",
    "BudgetsContainerName": "budgets",
    "RecurringExpensesContainerName": "recurring_expenses",
    "SettingsContainerName": "app_settings",
    "CatalogDocumentId": "catalogs",
    "MovementTypes": [
      "Basicos para vivir",
      "Hogar",
      "Salidas",
      "Imprevistos",
      "Suscripciones",
      "Deudas",
      "-",
      "Prestamo",
      "Bienestar",
      "Viajes",
      "Sogamoso obra"
    ],
    "PaymentMethods": [
      "TC Black",
      "TC Rappi",
      "TD Bancolombia",
      "TC Nu",
      "Efectivo",
      "Transferencia",
      "-",
      "Nequi"
    ]
  },
  "LocalAuth": {
    "Enabled": true,
    "AllowAnonymousInDevelopment": false,
    "JwtIssuer": "controleo-api",
    "JwtAudience": "controleo-clients",
    "JwtSecret": "TU_SECRETO_LOCAL_AUTH_CON_AL_MENOS_32_CARACTERES",
    "AccessTokenMinutes": 43200,
    "PasswordPepper": ""
  },
  "LlmProvider": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "Model": "gpt-4.1-nano",
    "MaxTokens": 260,
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 20
  },
  "AiBudget": {
    "MonthlyUsdCap": 2.0,
    "DailyRequestCap": 50,
    "PerUserMonthlyRequestCap": 20,
    "EstimatedUsdPerRequest": 0.003,
    "RecommendationCacheDays": 10,
    "MaterialScoreDelta": 7
  },
  "AllowedHosts": "*"
}
