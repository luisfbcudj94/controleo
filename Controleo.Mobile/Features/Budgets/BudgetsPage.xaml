<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Budgets.BudgetsPage"
             Title="Presupuestos"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Presupuestos"
                   FontSize="28"
                   FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="{StaticResource AppText}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="✕"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource AppText}"
                    FontSize="14"
                    Clicked="OnClosePageClicked" />
        </Grid>

        <!-- Helper Card -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12"
                BackgroundColor="{StaticResource AccentLight}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🎯" FontSize="20" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Define tus topes por categoría"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="Aquí ajustas el presupuesto mensual de cada tipo de gasto para controlar mejor tu avance."
                           FontSize="11"
                           TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

            <!-- Add Button -->
            <Button Grid.Row="2"
                Text="➕ Agregar presupuesto"
                FontAttributes="Bold"
                FontSize="16"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource PrimaryDarkText}"
                CornerRadius="16"
                HeightRequest="52"
                Clicked="OnAddBudgetClicked" />

        <!-- All movement types with budgets -->
            <Border Grid.Row="3" Padding="12" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                BackgroundColor="{StaticResource White}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
            </Border.Shadow>
            <RefreshView x:Name="BudgetsRefreshView" Refreshing="OnRefreshing">
                <CollectionView x:Name="BudgetsCollection" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No hay tipos de gasto configurados." HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{StaticResource AppHint}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" Margin="0,0,0,8" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                    BackgroundColor="{Binding CardColor}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" Grid.RowSpan="2" />
                                    <Label Grid.Column="1" Text="{Binding MovementType}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding BudgetLabel}"
                                           FontAttributes="Bold" FontSize="15"
                                           TextColor="{Binding BudgetLabelColor}" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                                           TextColor="{StaticResource AppHint}"
                                           Text="{Binding Subtitle}" />
                                    <Border Grid.RowSpan="2" Grid.Column="3" StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource AccentLight}" StrokeThickness="0"
                                            WidthRequest="32" HeightRequest="32" Padding="0"
                                            HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="✏️" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnEditBudgetTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

        <!-- Budget Edit Overlay -->
          <Grid x:Name="BudgetEditOverlay" Grid.RowSpan="4" IsVisible="False"
              BackgroundColor="#44000000" InputTransparent="False" ZIndex="20" Margin="-16">
            <Border StrokeShape="RoundRectangle 20" Padding="20" Margin="24" VerticalOptions="Center"
                    BackgroundColor="{StaticResource White}" Stroke="{StaticResource AppBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label x:Name="EditBudgetIcon" FontSize="28" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="EditBudgetTitle" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="✕" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource AppText}"
                                FontSize="14" Clicked="OnCancelBudgetEdit" />
                    </Grid>
                    <Label x:Name="EditBudgetCurrentLabel" FontSize="13" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="EditBudgetAmountEntry" Placeholder="Nuevo presupuesto" Keyboard="Numeric" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Button Text="Guardar" Clicked="OnSaveBudgetEdit"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}"
                                HorizontalOptions="Fill" />
                        <Button Grid.Column="1" Text="Quitar" Clicked="OnRemoveBudget"
                                BackgroundColor="{StaticResource ActionDelete}" TextColor="White" />
                        <Button Grid.Column="2" Text="Cancelar" Clicked="OnCancelBudgetEdit"
                                BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Loading -->
          <Grid x:Name="LoadingOverlay" Grid.RowSpan="4" IsVisible="False"
              BackgroundColor="#33000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ActivityIndicator IsRunning="True" WidthRequest="48" HeightRequest="48"
                               Color="{StaticResource Tertiary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Picker x:Name="MonthPicker" IsVisible="False" />
    </Grid>
</ContentPage>
