<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:Controleo.Mobile.Core.Services"
             x:Class="Controleo.Mobile.Features.Register.MainPage"
             Title="Controleo - Gastos"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="*">

        <RefreshView x:Name="MainRefreshView"
                     Grid.Row="0"
                     Refreshing="OnRefreshing">
                        <Grid Padding="20"
                                    RowDefinitions="*,Auto"
                                    RowSpacing="12">

                                <VerticalStackLayout Grid.Row="0" Spacing="12">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                        <Label Text="Registrar gasto"
                               FontSize="28"
                               FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource AppText}" />
                        <Border Grid.Column="1" Padding="10,6" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource Primary}" Stroke="Transparent" StrokeThickness="0">
                            <Label x:Name="HeaderMonthBadgeLabel"
                                   Text="Mes"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Amount Card -->
                    <Border StrokeShape="RoundRectangle 18" Padding="24,18" StrokeThickness="0"
                            BackgroundColor="{StaticResource PastelMint}">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="VALOR DEL GASTO" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="1"
                                   HorizontalTextAlignment="Center" />
                            <Grid ColumnDefinitions="Auto,*" HorizontalOptions="Center">
                                <Label Text="$" FontSize="30" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       x:Name="AmountField"
                                       Placeholder="0"
                                       MaxLength="14"
                                       FontSize="48"
                                       FontFamily="OpenSansSemibold"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalTextAlignment="Center"
                                       TextChanged="OnAmountFieldTextChanged" />
                            </Grid>
                            <Label Text="Ingresa el valor del gasto" FontSize="11"
                                   TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Description Row -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource PastelLavender}" Stroke="Transparent" StrokeThickness="0">
                                <Label Text="✏️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Entry Grid.Column="1"
                                   x:Name="DescriptionField"
                                   Placeholder="¿En qué gastaste?"
                                MaxLength="50"
                                   TextChanged="OnDescriptionFieldTextChanged"
                                   ClearButtonVisibility="WhileEditing"
                                   BackgroundColor="{StaticResource AppSurface}" />
                        </Grid>
                        <Label x:Name="DescriptionCounterLabel"
                               Text="0/50"
                               FontSize="11"
                               TextColor="{StaticResource AppHint}"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>

                                        <!-- Movement Type Grid -->
                    <Label Text="¿EN QUÉ CATEGORÍA?" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource AppHint}" CharacterSpacing="1" Margin="0,4,0,0" />
                                            <ScrollView x:Name="MovementTypeScroll"
                                                HeightRequest="112"
                                                Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never"
                                                VerticalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="MovementTypeGrid"
                                                           Spacing="0"
                                                           Padding="4,8,4,6" />
                                            </ScrollView>

                    <!-- Payment Method Grid -->
                    <Label Text="¿CÓMO PAGASTE?" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource AppHint}" CharacterSpacing="1" Margin="0,4,0,0" />
                                            <ScrollView x:Name="PaymentMethodScroll"
                                                HeightRequest="112"
                                                Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never"
                                                VerticalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="PaymentMethodGrid"
                                                           Spacing="0"
                                                           Padding="4,8,4,6" />
                                            </ScrollView>

                    <!-- Hidden Pickers (kept for compatibility) -->
                    <Picker x:Name="MovementTypePicker" IsVisible="False" />
                    <Picker x:Name="PaymentMethodPicker" IsVisible="False" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="10">
                    <Button x:Name="SaveButton"
                            Text="💾 Guardar gasto"
                            FontAttributes="Bold"
                            FontSize="18"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource PrimaryDarkText}"
                            CornerRadius="16"
                            HeightRequest="56"
                            Clicked="OnSaveClicked" />

                    <Button Text="Ver lista de gastos"
                            Clicked="OnGoToExpensesClicked"
                            BackgroundColor="{StaticResource BtnSecondaryBg}"
                            TextColor="{StaticResource BtnSecondaryText}"
                            FontAttributes="Bold"
                            HeightRequest="44" />

                </VerticalStackLayout>

            </Grid>
        </RefreshView>

        <Grid x:Name="OfflineStatusBackdrop"
              Grid.Row="0"
              IsVisible="False"
              ZIndex="14"
              Margin="-24"
              InputTransparent="False">
            <BoxView x:Name="OfflineStatusBackdropShade" Color="#8A111111" />
            <Border Margin="20" StrokeThickness="0" BackgroundColor="#33FFFFFF"
                StrokeShape="RoundRectangle 24" />
        </Grid>

        <Border x:Name="OfflineStatusToast"
            Grid.Row="0"
            IsVisible="False"
            ZIndex="15"
            Margin="24"
            MaximumWidthRequest="420"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="1"
            Padding="16,14"
            BackgroundColor="{StaticResource White}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="22" Opacity="0.18" />
            </Border.Shadow>
                 <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">
                <Label x:Name="OfflineStatusTitleLabel"
                       TextColor="{StaticResource AppText}"
                       FontSize="17"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <Label Grid.Row="1"
                       x:Name="OfflineStatusLabel"
                       TextColor="{StaticResource AppText}"
                       FontSize="13"
                       LineBreakMode="WordWrap" />

                <Label Grid.Row="2"
                       x:Name="OfflineStatusBenefitsLabel"
                       TextColor="{StaticResource AppHint}"
                       FontSize="12"
                       LineBreakMode="WordWrap" />

                <Button Grid.Row="3"
                        x:Name="OfflineStatusCtaButton"
                        Text="Suscribirme por $0.99"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="38"
                        Padding="14,0"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        CornerRadius="12"
                        Clicked="OnOfflineStatusCtaClicked" />
            </Grid>
        </Border>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              IsVisible="False"
              BackgroundColor="#33000000"
              InputTransparent="False"
              ZIndex="30"
              Margin="-16">
            <ActivityIndicator IsRunning="True"
                               WidthRequest="48"
                               HeightRequest="48"
                               Color="{StaticResource Tertiary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <Grid x:Name="AddCatalogOverlay"
              Grid.Row="0"
              IsVisible="False"
              BackgroundColor="#66000000"
              InputTransparent="False"
              ZIndex="20"
              Margin="-16">
            <Border StrokeShape="RoundRectangle 18"
                    Padding="16"
                    Margin="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420"
                    BackgroundColor="{StaticResource AppSurface}"
                    Stroke="Transparent"
                    StrokeThickness="0">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="AddCatalogTitleLabel"
                           Text="Agregar"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppText}" />

                    <Entry x:Name="AddCatalogNameEntry"
                           Placeholder="Escribe el nombre"
                           MaxLength="40"
                           ClearButtonVisibility="WhileEditing"
                           BackgroundColor="{StaticResource AppBg}" />

                    <Label Text="Selecciona un ícono"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           TextColor="{StaticResource AppHint}" />

                    <ScrollView HeightRequest="220"
                                VerticalScrollBarVisibility="Always">
                        <FlexLayout x:Name="AddCatalogIconGrid"
                                    Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Start"
                                    AlignContent="Start"
                                    Padding="10,10,10,6" />
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Cancelar"
                                Clicked="OnAddCatalogCancelClicked"
                                BackgroundColor="{StaticResource BtnSecondaryBg}"
                                TextColor="{StaticResource BtnSecondaryText}"
                                FontAttributes="Bold"
                                HeightRequest="44" />
                        <Button Grid.Column="1"
                                Text="Guardar"
                                Clicked="OnAddCatalogConfirmClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource PrimaryDarkText}"
                                FontAttributes="Bold"
                                HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
