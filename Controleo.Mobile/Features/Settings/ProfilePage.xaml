<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Settings.ProfilePage"
             Title="Perfil"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Border StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    Padding="18"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}">
                            <Label x:Name="AvatarLabel"
                                   Text="C"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="NameLabel"
                                   Text="Usuario"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Label x:Name="EmailLabel"
                                   Text="correo@ejemplo.com"
                                   FontSize="13"
                                   TextColor="{StaticResource AppHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Cerrar sesión"
                HeightRequest="48"
                CornerRadius="14"
                BackgroundColor="{StaticResource ActionDelete}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="OnLogoutClicked" />
    </Grid>
</ContentPage>
