<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Settings.ProfilePage"
             Title="Perfil"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Border StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    Padding="18"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}">
                            <Label x:Name="AvatarLabel"
                                   Text="C"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="NameLabel"
                                   Text="Usuario"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Label x:Name="EmailLabel"
                                   Text="correo@ejemplo.com"
                                   FontSize="13"
                                   TextColor="{StaticResource AppHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    Padding="16"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ingreso mensual (opcional)"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppText}" />
                    <Label Text="Este dato mejora la precision del score financiero y las recomendaciones premium."
                           FontSize="12"
                           TextColor="{StaticResource AppHint}"
                           LineBreakMode="WordWrap" />

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource AppBorder}"
                            BackgroundColor="{StaticResource AppSurface2}"
                            Padding="12,10">
                        <Entry x:Name="MonthlyIncomeEntry"
                               Placeholder="Ejemplo: 3500000"
                               Keyboard="Numeric"
                               FontSize="14"
                               TextColor="{StaticResource AppText}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="IncomeStatusLabel"
                               Text=""
                               FontSize="11"
                               VerticalOptions="Center"
                               TextColor="{StaticResource AppHint}" />

                        <Button Grid.Column="1"
                                Text="Guardar"
                                HeightRequest="42"
                                CornerRadius="12"
                                Padding="18,0"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource PrimaryDarkText}"
                                Clicked="OnSaveIncomeClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Cerrar sesión"
                HeightRequest="48"
                CornerRadius="14"
                BackgroundColor="{StaticResource ActionDelete}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="OnLogoutClicked" />
    </Grid>
</ContentPage>
