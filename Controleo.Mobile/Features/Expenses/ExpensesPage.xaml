<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Expenses.ExpensesPage"
             Title="Gastos"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="10">

        <!-- Month Selector -->
        <Border Grid.Row="0" StrokeShape="RoundRectangle 16" Padding="8" StrokeThickness="0"
                BackgroundColor="{StaticResource PastelSky}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}"
                        Clicked="OnPrevMonthClicked" />
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="MonthSelectorLabel" VerticalOptions="Center" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthSelectorTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="2" Text="▶" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}"
                        Clicked="OnNextMonthClicked" />
            </Grid>
        </Border>

        <!-- Search -->
        <Border Grid.Row="2" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource AppBorder}" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Label Text="🔍" VerticalOptions="Center" />
                <Entry Grid.Column="1" Placeholder="Buscar gasto..." ClearButtonVisibility="WhileEditing"
                       BackgroundColor="Transparent" TextChanged="OnSearchTextChanged" />
                <Button Grid.Column="2" x:Name="FilterButton" Text="Filtrar" HeightRequest="34" CornerRadius="10"
                        Padding="12,0" BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}"
                        FontSize="12" Clicked="OnOpenFiltersClicked" />
            </Grid>
        </Border>

        <!-- Active Filters -->
        <Border Grid.Row="3" x:Name="FilterSummaryBorder" IsVisible="False"
                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                BackgroundColor="{StaticResource AppSurface2}" Padding="12,8">
            <Label x:Name="FilterSummaryLabel" FontSize="11" TextColor="{StaticResource AppHint}" />
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="4" Padding="12" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                BackgroundColor="{StaticResource White}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto">
                <Label Text="Movimientos del mes" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8"
                      VerticalOptions="Center" Margin="0,8,0,0">
                    <Label Text="Mostrar" VerticalOptions="Center" FontSize="12" TextColor="{StaticResource AppHint}" />
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="PageSizeSelectorLabel" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPageSizeSelectorTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Label Grid.Column="2" x:Name="PaginationStatusLabel" HorizontalTextAlignment="Center"
                           VerticalOptions="Center" FontSize="12" TextColor="{StaticResource AppHint}" />
                    <Button Grid.Column="3" x:Name="PrevPageButton" Text="◀" WidthRequest="38" HeightRequest="38"
                            CornerRadius="19" BackgroundColor="{StaticResource AppSurface2}" Clicked="OnPrevPageClicked" />
                    <Button Grid.Column="4" x:Name="NextPageButton" Text="▶" WidthRequest="38" HeightRequest="38"
                            CornerRadius="19" BackgroundColor="{StaticResource AppSurface2}" Clicked="OnNextPageClicked" />
                </Grid>
            </Grid>
        </Border>

        <Picker x:Name="MonthPicker" IsVisible="False" ItemDisplayBinding="{Binding Label}"
                SelectedIndexChanged="OnMonthPickerChanged" />
        <Picker x:Name="PageSizePicker" IsVisible="False" SelectedIndexChanged="OnPageSizeChanged" />

        <!-- Expense List -->
        <RefreshView Grid.Row="5" x:Name="ExpensesRefreshView" Refreshing="OnRefreshing" Margin="0,4,0,0">
            <CollectionView x:Name="ExpensesCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Aún no hay gastos registrados." HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{StaticResource AppHint}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,6" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                BackgroundColor="{Binding CardColor}">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Icon}" FontSize="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Description}" FontAttributes="Bold" FontSize="14"
                                           MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N0}'}"
                                           FontAttributes="Bold" FontSize="15" TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                                <Label Text="{Binding Date, StringFormat='Fecha: {0:yyyy-MM-dd}'}" FontSize="11"
                                       TextColor="{StaticResource AppHint}" />
                                <Grid ColumnDefinitions="*,*">
                                    <Label Text="{Binding MovementType, StringFormat='Sección: {0}'}" FontSize="11"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Grid.Column="1" Text="{Binding PaymentMethod, StringFormat='Medio: {0}'}" FontSize="11"
                                           TextColor="{StaticResource Gray600}" HorizontalTextAlignment="End" />
                                </Grid>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource AccentLight}"
                                            StrokeThickness="0" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="✏️" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnEditExpenseTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="#FFE0E0"
                                            StrokeThickness="0" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="🗑️" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnDeleteExpenseTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.RowSpan="6" x:Name="OfflineStatusBackdrop" IsVisible="False"
              ZIndex="14" Margin="-16" InputTransparent="False">
            <BoxView x:Name="OfflineStatusBackdropShade" Color="#8A111111" />
            <Border Margin="20" StrokeThickness="0" BackgroundColor="#33FFFFFF"
                StrokeShape="RoundRectangle 24" />
        </Grid>

        <Border Grid.RowSpan="6" x:Name="OfflineStatusToast" IsVisible="False"
                ZIndex="15" Margin="24" MaximumWidthRequest="420"
                HorizontalOptions="Center" VerticalOptions="Center"
                StrokeShape="RoundRectangle 20" StrokeThickness="1"
                BackgroundColor="{StaticResource White}" Padding="16,14">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="22" Opacity="0.18" />
            </Border.Shadow>
                 <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">
                <Label x:Name="OfflineStatusTitleLabel" FontSize="17" FontAttributes="Bold"
                       TextColor="{StaticResource AppText}" VerticalOptions="Center" />

                  <Label Grid.Row="1" x:Name="OfflineStatusLabel"
                       FontSize="13" LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppText}" />

                  <Label Grid.Row="2" x:Name="OfflineStatusBenefitsLabel"
                       FontSize="12" LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppHint}" />

                  <Button Grid.Row="3" x:Name="OfflineStatusCtaButton"
                        Text="Suscribirme por $0.99" HeightRequest="38" Padding="14,0"
                        FontSize="12" FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}"
                        CornerRadius="12" Clicked="OnOfflineStatusCtaClicked" />
            </Grid>
        </Border>

        <!-- Edit Modal Overlay -->
          <Grid x:Name="EditPanel" Grid.RowSpan="6" IsVisible="False" ZIndex="20"
              BackgroundColor="#44000000" InputTransparent="False" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="24">
                <Border Padding="18" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}" Stroke="{StaticResource AppBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Editar gasto" FontAttributes="Bold" FontSize="18" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                    BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource AppText}"
                                    FontSize="14" Clicked="OnCancelEditClicked" />
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="FECHA DEL GASTO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AppSurface2}"
                                    Stroke="{StaticResource AppBorder}" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="EditDateSelectorLabel" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditDateSelectorTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="GASTO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                            <Entry x:Name="EditDescriptionEntry" Placeholder="Descripción" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="VALOR DEL GASTO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                            <Entry x:Name="EditAmountEntry" Placeholder="Valor" Keyboard="Numeric" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="TIPO DE GASTO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                            <Border x:Name="EditMovementSelectorBorder" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="EditMovementSelectorLabel" Text="Seleccionar"
                                           TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="▼" FontSize="11"
                                           TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditMovementSelectorTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="MEDIO DE PAGO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                            <Border x:Name="EditPaymentSelectorBorder" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="EditPaymentSelectorLabel" Text="Seleccionar"
                                           TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="▼" FontSize="11"
                                           TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditPaymentSelectorTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                            <Button Text="Cancelar" Clicked="OnCancelEditClicked"
                                    BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}" />
                            <Button Text="Guardar" Clicked="OnSaveEditClicked"
                                    BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}" />
                        </HorizontalStackLayout>
                        <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource AppHint}" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Edit Movement Picker Overlay -->
          <Grid x:Name="EditMovementPickerOverlay" Grid.RowSpan="6" IsVisible="False"
              BackgroundColor="#55000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="16">
                <Border StrokeShape="RoundRectangle 20" Padding="16,16,12,16"
                        BackgroundColor="{StaticResource White}" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Tipo de gasto" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                                    CornerRadius="18" BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource AppText}" FontSize="14"
                                    Clicked="OnCloseEditMovementPicker" Padding="0" Margin="0,0,-4,0" />
                        </Grid>
                        <FlexLayout x:Name="EditMovementPickerFlexLayout"
                                    Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Edit Payment Picker Overlay -->
          <Grid x:Name="EditPaymentPickerOverlay" Grid.RowSpan="6" IsVisible="False"
              BackgroundColor="#55000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="16">
                <Border StrokeShape="RoundRectangle 20" Padding="16,16,12,16"
                        BackgroundColor="{StaticResource White}" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Medio de pago" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                                    CornerRadius="18" BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource AppText}" FontSize="14"
                                    Clicked="OnCloseEditPaymentPicker" Padding="0" Margin="0,0,-4,0" />
                        </Grid>
                        <FlexLayout x:Name="EditPaymentPickerFlexLayout"
                                    Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Loading -->
          <Grid x:Name="LoadingOverlay" Grid.RowSpan="6" IsVisible="False"
                            BackgroundColor="#33000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ActivityIndicator IsRunning="True" WidthRequest="48" HeightRequest="48"
                               Color="{StaticResource Tertiary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
