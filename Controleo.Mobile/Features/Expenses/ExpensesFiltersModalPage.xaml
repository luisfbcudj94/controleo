<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Expenses.ExpensesFiltersModalPage"
             BackgroundColor="#44000000"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24">
        <Border VerticalOptions="Center" StrokeShape="RoundRectangle 20" Padding="20"
                BackgroundColor="{StaticResource AppBg}" Stroke="Transparent" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="24" Opacity="0.18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Filtrar gastos" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                    <Border Grid.Column="1" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource AppSurface2}" Stroke="Transparent" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="✕" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{StaticResource AppHint}" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Text="TIPO DE MOVIMIENTO" FontSize="10" FontAttributes="Bold"
                           TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                    <Border x:Name="MovementTypeBorder" StrokeShape="RoundRectangle 14" Padding="14,12"
                            BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMovementTypeTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="MovementTypeLabel" Text="Todos" FontSize="14"
                                   TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="▼" FontSize="10"
                                   TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="MEDIO DE PAGO" FontSize="10" FontAttributes="Bold"
                           TextColor="{StaticResource AppHint}" CharacterSpacing="0.8" />
                    <Border x:Name="PaymentMethodBorder" StrokeShape="RoundRectangle 14" Padding="14,12"
                            BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPaymentMethodTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="PaymentMethodLabel" Text="Todos" FontSize="14"
                                   TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="▼" FontSize="10"
                                   TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                    <Button Text="Limpiar" Clicked="OnClearClicked" CornerRadius="14" HeightRequest="46"
                            BackgroundColor="{StaticResource AppSurface2}" TextColor="{StaticResource AppText}"
                            FontAttributes="Bold" FontSize="14" />
                    <Button Grid.Column="1" Text="Aplicar" Clicked="OnApplyClicked" CornerRadius="14" HeightRequest="46"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}"
                            FontAttributes="Bold" FontSize="14" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
