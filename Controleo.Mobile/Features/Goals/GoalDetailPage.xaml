<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Features.Goals.GoalDetailPage"
             BackgroundColor="{StaticResource AppBg}">

    <Grid>

    <!-- Loading Indicator -->
    <ActivityIndicator x:Name="DetailLoadingIndicator" IsRunning="False" IsVisible="False"
                       Color="{StaticResource Primary}" VerticalOptions="Center" HorizontalOptions="Center"
                       ZIndex="5" />

    <ScrollView x:Name="DetailScrollContent">
        <VerticalStackLayout Spacing="0">

            <!-- ═══ MAIN CARD ═══ -->
            <Border StrokeShape="RoundRectangle 24" BackgroundColor="White" Margin="12,12,12,0"
                    Stroke="#14000000" StrokeThickness="1">
                <VerticalStackLayout Spacing="0">

                    <!-- HEADER: icon + title + close -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="18,18,18,14">
                        <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 12"
                                StrokeThickness="0" BackgroundColor="#E8F4FF">
                            <Label x:Name="GoalIconLabel" Text="🎯" FontSize="22"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label x:Name="HeroGoalName" Text="" FontSize="16" FontAttributes="Bold"
                                   TextColor="#1A1917" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="📅" FontSize="11" />
                                <Label x:Name="DetailDaysLabel" Text="" FontSize="11" TextColor="#9A9891" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="✕" WidthRequest="28" HeightRequest="28"
                                CornerRadius="14" FontSize="13" Padding="0"
                                BackgroundColor="#F4F3EF" TextColor="#9A9891"
                                Clicked="OnBackClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#0F000000" />

                    <!-- BODY -->
                    <VerticalStackLayout Padding="18,20,18,18" Spacing="10">

                        <!-- Amount row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="DetailAmountLabel" Text="$0" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1A1917" VerticalOptions="Center" />
                            <Label x:Name="HeaderTitle" Grid.Column="1" Text="Meta: $0" FontSize="13"
                                   TextColor="#9A9891" VerticalOptions="Center" />
                        </Grid>

                        <!-- Progress bar -->
                        <VerticalStackLayout Spacing="6">
                            <Border HeightRequest="12" StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0" BackgroundColor="#F0EDE8">
                                <Border x:Name="ProgressBarFill" HeightRequest="12"
                                        StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                        HorizontalOptions="Start" WidthRequest="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="#7EC8E3" />
                                            <GradientStop Offset="1" Color="#5BB3D4" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label x:Name="ProgressPercentLabel" Text="0%" FontSize="13"
                                       FontAttributes="Bold" TextColor="#5BB3D4" />
                                <Label x:Name="ProgressRemainingLabel" Grid.Column="1" Text=""
                                       FontSize="12" TextColor="#B0ADA6" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Status badge -->
                        <Border x:Name="DetailStatusBadge" StrokeShape="RoundRectangle 99"
                                StrokeThickness="1.5" Padding="12,5" HorizontalOptions="Start">
                            <HorizontalStackLayout Spacing="5">
                                <Border x:Name="StatusDot" WidthRequest="6" HeightRequest="6"
                                        StrokeShape="RoundRectangle 3" StrokeThickness="0"
                                        VerticalOptions="Center" />
                                <Label x:Name="DetailStatusLabel" Text="Calculando..."
                                       FontSize="12" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Stats grid: blue / purple / amber -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                            <Border StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                    Stroke="#2E5BB3D4" BackgroundColor="#F0F8FF" Padding="11,10">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="SUGERIDO" FontSize="9" TextColor="#B0ADA6"
                                           CharacterSpacing="0.8" HorizontalTextAlignment="Center" />
                                    <Label x:Name="SuggestedStatLabel" Text="$0" FontSize="14"
                                           FontAttributes="Bold" TextColor="#2A7FA8"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="SuggestedSubLabel" Text="por mes" FontSize="10"
                                           TextColor="#9A9891" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                    Stroke="#268C64DC" BackgroundColor="#F5F0FF" Padding="11,10">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="PROYECCIÓN" FontSize="9" TextColor="#B0ADA6"
                                           CharacterSpacing="0.8" HorizontalTextAlignment="Center" />
                                    <Label x:Name="ProjectionStatLabel" Text="--" FontSize="14"
                                           FontAttributes="Bold" TextColor="#6A3EB0"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="ProjectionSubLabel" Text="al ritmo actual" FontSize="10"
                                           TextColor="#9A9891" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                    Stroke="#2EE8A800" BackgroundColor="#FFF8EC" Padding="11,10">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="PRIORIDAD" FontSize="9" TextColor="#B0ADA6"
                                           CharacterSpacing="0.8" HorizontalTextAlignment="Center" />
                                    <Label x:Name="PriorityStatLabel" Text="--" FontSize="14"
                                           FontAttributes="Bold" TextColor="#9A6500"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="PrioritySubLabel" Text="" FontSize="10"
                                           TextColor="#9A9891" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#0F000000" />

                    <!-- FOOTER BUTTONS -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="18,14,18,18">
                        <Button x:Name="AddContributionButton" Text="➕ Agregar abono"
                                BackgroundColor="#1A1917" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="12"
                                HeightRequest="44" Clicked="OnAddContributionClicked" />
                        <Button Grid.Column="1" Text="✏️ Editar"
                                BackgroundColor="#F4F3EF" TextColor="#44433F"
                                FontSize="13" CornerRadius="12" HeightRequest="44"
                                Clicked="OnEditGoalClicked" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Hidden ring kept for code compat -->
            <GraphicsView x:Name="DetailRingView" WidthRequest="0" HeightRequest="0" IsVisible="False" />

            <!-- Simulator Card -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="14"
                    Margin="12,12,12,0" Stroke="#14000000" StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🧪 Simulador" FontSize="15" FontAttributes="Bold" TextColor="#1A1917" />
                    <Label Text="¿Qué pasa si ahorro un monto diferente al mes?" FontSize="12" TextColor="#9A9891" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="SimAmountEntry" Placeholder="Monto mensual" Keyboard="Numeric" FontSize="14" />
                        <Button Grid.Column="1" Text="Simular" HeightRequest="38" FontSize="12"
                                BackgroundColor="#1A1917" TextColor="White"
                                CornerRadius="10" Padding="12,0"
                                Clicked="OnSimulateClicked" />
                    </Grid>
                    <Border x:Name="SimResultBorder" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                            BackgroundColor="#F0F8FF" Padding="10" IsVisible="False">
                        <Label x:Name="SimResultLabel" Text="" FontSize="12"
                               TextColor="#1A1917" LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Contributions History -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="14"
                    Margin="12,12,12,16" Stroke="#14000000" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📋 Historial de aportes" FontSize="15" FontAttributes="Bold" TextColor="#1A1917" />
                    <Label x:Name="NoContributionsLabel" Text="Aún no hay aportes registrados."
                           FontSize="12" TextColor="{StaticResource AppHint}" IsVisible="False" />
                    <CollectionView x:Name="ContributionsCollection" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,6" StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0" BackgroundColor="{StaticResource AppSurface2}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Text="💵" FontSize="16" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding AmountLabel}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource AppText}" />
                                            <Label Text="{Binding DateLabel}" FontSize="10"
                                                   TextColor="{StaticResource AppHint}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <Button Text="✏️" WidthRequest="30" HeightRequest="30"
                                                    CornerRadius="15" FontSize="12" Padding="0"
                                                    BackgroundColor="#E9F3FD"
                                                    Clicked="OnEditContributionClicked" CommandParameter="{Binding .}" />
                                            <Button Text="✕" WidthRequest="30" HeightRequest="30"
                                                    CornerRadius="15" FontSize="11" Padding="0"
                                                    BackgroundColor="#FDE3E5" TextColor="#A11D2A"
                                                    Clicked="OnDeleteContributionClicked" CommandParameter="{Binding Id}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    <!-- Contribution Overlay -->
    <Grid x:Name="ContributionOverlay" BackgroundColor="#44000000"
          IsVisible="False" ZIndex="10" Padding="16">
        <Border VerticalOptions="Center" StrokeShape="RoundRectangle 20" Padding="20"
                BackgroundColor="White" Stroke="{StaticResource AppBorder}" MaximumWidthRequest="400">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" BackgroundColor="#EAF6EE">
                        <Label Text="💰" FontSize="20" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Registrar Aporte" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource AppText}" />
                        <Label x:Name="ContribMotivationLabel" Text="¡Cada aporte te acerca a tu meta!" FontSize="11"
                               TextColor="{StaticResource AppHint}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="✕" WidthRequest="34" HeightRequest="34"
                            CornerRadius="17" FontSize="14" Padding="0"
                            BackgroundColor="{StaticResource AppSurface2}"
                            TextColor="{StaticResource AppText}"
                            Clicked="OnContributionOverlayClose" />
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Monto ($)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="ContribAmountEntry" Placeholder="50.000" Keyboard="Numeric" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Nota (opcional)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="ContribNoteEntry" Placeholder="Ej: Ahorro quincenal" FontSize="14" MaxLength="200" />
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                        BackgroundColor="#EAF6EE" Padding="10,8">
                    <Label x:Name="ContribSuggestedLabel" Text="" FontSize="11"
                           TextColor="#1B4332" HorizontalTextAlignment="Center" />
                </Border>

                <Button Text="💰 Aportar" FontSize="15" FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        HeightRequest="46" CornerRadius="14"
                        Clicked="OnConfirmContributionClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- Edit Goal Overlay -->
    <Grid x:Name="EditGoalOverlay" BackgroundColor="#44000000"
          IsVisible="False" ZIndex="10" Padding="16">
        <Border VerticalOptions="Center" StrokeShape="RoundRectangle 20" Padding="20"
                BackgroundColor="White" Stroke="{StaticResource AppBorder}" MaximumWidthRequest="400">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" BackgroundColor="#E8F4FF">
                        <Label Text="✏️" FontSize="20" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Editar Meta" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource AppText}" />
                        <Label Text="Ajusta los detalles de tu meta" FontSize="11"
                               TextColor="{StaticResource AppHint}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="✕" WidthRequest="34" HeightRequest="34"
                            CornerRadius="17" FontSize="14" Padding="0"
                            BackgroundColor="{StaticResource AppSurface2}"
                            TextColor="{StaticResource AppText}"
                            Clicked="OnEditGoalOverlayClose" />
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Nombre" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="EditGoalNameEntry" Placeholder="Nombre de la meta" FontSize="15" MaxLength="100" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Monto objetivo ($)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="EditGoalAmountEntry" Placeholder="500.000" Keyboard="Numeric" FontSize="15" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Fecha objetivo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AppSurface2}"
                            Stroke="{StaticResource AppBorder}" Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="EditGoalDateLabel" Text="Selecciona fecha" FontSize="14"
                                   TextColor="{StaticResource AppText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📅" FontSize="16" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickEditGoalDateTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Prioridad" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button x:Name="EditPriorityHigh" Text="🔴 Alta" FontSize="12" HeightRequest="36"
                                CornerRadius="10" Clicked="OnEditPrioritySelected" CommandParameter="Alta" />
                        <Button Grid.Column="1" x:Name="EditPriorityMedium" Text="🟡 Media" FontSize="12" HeightRequest="36"
                                CornerRadius="10" Clicked="OnEditPrioritySelected" CommandParameter="Media" />
                        <Button Grid.Column="2" x:Name="EditPriorityLow" Text="🟢 Baja" FontSize="12" HeightRequest="36"
                                CornerRadius="10" Clicked="OnEditPrioritySelected" CommandParameter="Baja" />
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Guardar" FontSize="15" FontAttributes="Bold"
                            BackgroundColor="#1A1917" TextColor="White"
                            HeightRequest="46" CornerRadius="12"
                            Clicked="OnConfirmEditGoalClicked" />
                    <Button Grid.Column="1" Text="🗑️ Eliminar" FontSize="13"
                            BackgroundColor="#FDE3E5" TextColor="#A11D2A"
                            HeightRequest="46" CornerRadius="12"
                            Clicked="OnDeleteGoalClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary />
    </ContentPage.Resources>
</ContentPage>
