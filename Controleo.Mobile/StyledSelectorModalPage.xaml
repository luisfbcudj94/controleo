<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.StyledSelectorModalPage"
             BackgroundColor="#AA000000"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20">
        <Border VerticalOptions="Center"
                StrokeShape="RoundRectangle 18"
                Padding="14"
            BackgroundColor="{StaticResource AppSurface}"
            Stroke="{StaticResource AppBorder}">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="TitleLabel"
                           FontSize="18"
                          FontAttributes="Bold" />
                    <Button Grid.Column="1"
                            Text="✕"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                        BackgroundColor="{StaticResource ActionDelete}"
                            TextColor="White"
                            Clicked="OnCloseClicked" />
                </Grid>

                <CollectionView Grid.Row="1"
                                x:Name="OptionsCollection"
                                SelectionMode="None"
                                HeightRequest="360">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                    Margin="0,0,0,8"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource AppSurface2}"
                                    Stroke="{StaticResource AppBorder}"
                                    MinimumHeightRequest="48">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryDark}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Label}"
                                       FontSize="15"
                                       TextColor="{StaticResource AppText}"
                                        HorizontalTextAlignment="Center"
                                        HorizontalOptions="Fill"
                                       VerticalTextAlignment="Center"
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOptionTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
