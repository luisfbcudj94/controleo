<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.SettingsPage"
             Title="Configuración">

    <RefreshView x:Name="SettingsRefreshView"
                 Refreshing="OnRefreshing">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border StrokeShape="RoundRectangle 12" Padding="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="◀" WidthRequest="44" Clicked="OnPrevMonthClicked" />
                    <Picker Grid.Column="1"
                            x:Name="MonthPicker"
                            Title="Mes"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedIndexChanged="OnMonthPickerChanged" />
                    <Button Grid.Column="2" Text="▶" WidthRequest="44" Clicked="OnNextMonthClicked" />
                </Grid>
            </Border>

            <Border Padding="12" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Secciones de gasto" FontAttributes="Bold" FontSize="18" />
                    <Entry x:Name="NewMovementEntry" Placeholder="Nueva sección" />
                    <Button Text="Agregar sección" Clicked="OnAddMovementClicked" />
                    <CollectionView x:Name="MovementCollection" SelectionMode="Single" SelectionChanged="OnMovementSelectionChanged" HeightRequest="180" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Editar" Clicked="OnEditMovementClicked" />
                        <Button Text="Eliminar"
                                Clicked="OnDeleteMovementClicked"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Medios de pago" FontAttributes="Bold" FontSize="18" />
                    <Entry x:Name="NewPaymentEntry" Placeholder="Nuevo medio de pago" />
                    <Button Text="Agregar medio" Clicked="OnAddPaymentClicked" />
                    <CollectionView x:Name="PaymentCollection" SelectionMode="Single" SelectionChanged="OnPaymentSelectionChanged" HeightRequest="180" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Editar" Clicked="OnEditPaymentClicked" />
                        <Button Text="Eliminar"
                                Clicked="OnDeletePaymentClicked"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SaveSettingsButton"
                    Text="Guardar configuración"
                    Clicked="OnSaveSettingsClicked" />

            <Label x:Name="StatusLabel" FontSize="12" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>

        <Grid x:Name="LoadingOverlay"
                    IsVisible="False"
                    BackgroundColor="#66000000"
                    InputTransparent="False">
                <ActivityIndicator IsRunning="True"
                                                     WidthRequest="52"
                                                     HeightRequest="52"
                                                     Color="White"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
        </Grid>

</ContentPage>
