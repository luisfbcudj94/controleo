<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.SettingsPage"
             Title="Configuración">

    <Grid RowDefinitions="*">
        <RefreshView x:Name="SettingsRefreshView"
                     Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Border Padding="12" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Secciones de gasto" FontAttributes="Bold" FontSize="18" />
                            <Entry x:Name="NewMovementEntry" Placeholder="Nueva sección" />
                            <Button Text="Agregar sección" Clicked="OnAddMovementClicked" />
                            <CollectionView x:Name="MovementCollection" SelectionMode="Single" SelectionChanged="OnMovementSelectionChanged" HeightRequest="180">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSurface2}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AppBorder}" />
                                                                <Setter Property="StrokeThickness" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
                                                                <Setter Property="Stroke" Value="{StaticResource PrimaryDark}" />
                                                                <Setter Property="StrokeThickness" Value="2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                            <Label Text="{Binding .}"
                                                   VerticalOptions="Center"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Label x:Name="SelectedMovementLabel"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"
                                   FontSize="12"
                                   TextColor="{StaticResource AppHint}"
                                   Text="Sin sección seleccionada" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <ImageButton Source="bi_pencil.svg"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             CornerRadius="8"
                                             Padding="6"
                                             BackgroundColor="{StaticResource ActionEdit}"
                                             SemanticProperties.Description="Editar sección"
                                             Clicked="OnEditMovementClicked" />
                                <ImageButton Source="bi_trash.svg"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             CornerRadius="8"
                                             Padding="6"
                                             BackgroundColor="{StaticResource ActionDelete}"
                                             SemanticProperties.Description="Eliminar sección"
                                             Clicked="OnDeleteMovementClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="12" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Medios de pago" FontAttributes="Bold" FontSize="18" />
                            <Entry x:Name="NewPaymentEntry" Placeholder="Nuevo medio de pago" />
                            <Button Text="Agregar medio" Clicked="OnAddPaymentClicked" />
                            <CollectionView x:Name="PaymentCollection" SelectionMode="Single" SelectionChanged="OnPaymentSelectionChanged" HeightRequest="180">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSurface2}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AppBorder}" />
                                                                <Setter Property="StrokeThickness" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
                                                                <Setter Property="Stroke" Value="{StaticResource PrimaryDark}" />
                                                                <Setter Property="StrokeThickness" Value="2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                            <Label Text="{Binding .}"
                                                   VerticalOptions="Center"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Label x:Name="SelectedPaymentLabel"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"
                                   FontSize="12"
                                   TextColor="{StaticResource AppHint}"
                                   Text="Sin medio seleccionado" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <ImageButton Source="bi_pencil.svg"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             CornerRadius="8"
                                             Padding="6"
                                             BackgroundColor="{StaticResource ActionEdit}"
                                             SemanticProperties.Description="Editar medio de pago"
                                             Clicked="OnEditPaymentClicked" />
                                <ImageButton Source="bi_trash.svg"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             CornerRadius="8"
                                             Padding="6"
                                             BackgroundColor="{StaticResource ActionDelete}"
                                             SemanticProperties.Description="Eliminar medio de pago"
                                             Clicked="OnDeletePaymentClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="12" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Sesión" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="⇥"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    BackgroundColor="{StaticResource ActionDelete}"
                                    TextColor="White"
                                    FontSize="18"
                                    Clicked="OnLogoutClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid x:Name="EditOverlay"
              IsVisible="False"
              BackgroundColor="#AA000000"
              InputTransparent="False"
              ZIndex="20">
            <Border StrokeShape="RoundRectangle 16"
                    Padding="14"
                    Margin="20"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="EditModalTitleLabel" Text="Editar" FontSize="18" FontAttributes="Bold" />
                        <Button Grid.Column="1"
                                Text="✕"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                BackgroundColor="{StaticResource ActionDelete}"
                                TextColor="White"
                                Clicked="OnCancelEditModalClicked" />
                    </Grid>
                    <Label Text="Nuevo nombre" FontSize="12" TextColor="{StaticResource AppHint}" />
                    <Entry x:Name="EditModalEntry" Placeholder="Nombre" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                        <Button Text="Cancelar"
                                Clicked="OnCancelEditModalClicked"
                            BackgroundColor="{StaticResource AppSurface2}"
                                TextColor="{StaticResource AppText}" />
                        <Button Text="Guardar"
                                Clicked="OnConfirmEditModalClicked"
                                BackgroundColor="{StaticResource ActionSave}"
                                TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              IsVisible="False"
              BackgroundColor="#66000000"
              InputTransparent="False"
              ZIndex="10">
            <ActivityIndicator IsRunning="True"
                               WidthRequest="52"
                               HeightRequest="52"
                               Color="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
