<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.StyledConfirmModalPage"
             BackgroundColor="#AA000000"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20">
        <Border VerticalOptions="Center"
                StrokeShape="RoundRectangle 18"
                Padding="14"
                BackgroundColor="{StaticResource AppSurface}"
                Stroke="{StaticResource AppBorder}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="TitleLabel"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Button Grid.Column="1"
                            Text="✕"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            BackgroundColor="{StaticResource ActionDelete}"
                            TextColor="White"
                            Clicked="OnCancelClicked" />
                </Grid>

                <Label Grid.Row="1"
                       x:Name="MessageLabel"
                       FontSize="14"
                       TextColor="{StaticResource AppHint}"
                       LineBreakMode="WordWrap" />

                <HorizontalStackLayout Grid.Row="2"
                                       Spacing="8"
                                       HorizontalOptions="End">
                    <Button Text="Cancelar"
                            Clicked="OnCancelClicked"
                            BackgroundColor="{StaticResource AppSurface2}" />
                    <Button Text="Eliminar"
                            Clicked="OnConfirmClicked"
                            BackgroundColor="{StaticResource ActionDelete}"
                            TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>