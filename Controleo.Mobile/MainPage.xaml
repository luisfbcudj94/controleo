<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:Controleo.Mobile.Services"
             x:Class="Controleo.Mobile.MainPage"
             Title="Controleo - Gastos">

       <Grid>

        <RefreshView x:Name="MainRefreshView"
                                     Refreshing="OnRefreshing">
        <ScrollView>
               <VerticalStackLayout Padding="18" Spacing="14">
                       <Border StrokeShape="RoundRectangle 12" Padding="10">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <Button Grid.Column="0" Text="◀" WidthRequest="44" Clicked="OnPrevMonthClicked" />
                              <Picker Grid.Column="1"
                                            x:Name="MonthPicker"
                                            Title="Mes"
                                            ItemDisplayBinding="{Binding Label}"
                                            SelectedIndexChanged="OnMonthPickerChanged" />
                              <Button Grid.Column="2" Text="▶" WidthRequest="44" Clicked="OnNextMonthClicked" />
                       </Grid>
                 </Border>

           <Border StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray700}}"
                  Padding="16"
                  StrokeShape="RoundRectangle 16">
              <VerticalStackLayout Spacing="6">
                  <Label Text="Registrar gasto"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White" />
                  <Label Text="Controla tus movimientos diarios de forma rápida."
                        TextColor="White"
                        Opacity="0.9" />
              </VerticalStackLayout>
           </Border>

           <Border StrokeShape="RoundRectangle 14"
                  Padding="14">
              <VerticalStackLayout Spacing="10">
                  <Label Text="Fecha" FontAttributes="Bold" />
                  <DatePicker x:Name="DatePickerField" />

                  <Label Text="Descripción" FontAttributes="Bold" />
                  <Entry x:Name="DescriptionField"
                        Placeholder="Ej: Mercado de la semana"
                        ClearButtonVisibility="WhileEditing" />

                  <Label Text="Valor" FontAttributes="Bold" />
                  <Entry x:Name="AmountField"
                        Placeholder="Ej: 45000"
                        Keyboard="Numeric" />

                  <Label Text="Tipo de movimiento" FontAttributes="Bold" />
                  <Picker x:Name="MovementTypePicker"
                         Title="Selecciona tipo" />

                  <Label Text="Medio de pago" FontAttributes="Bold" />
                  <Picker x:Name="PaymentMethodPicker"
                         Title="Selecciona medio" />

                  <Button x:Name="SaveButton"
                         Margin="0,8,0,0"
                         Text="Guardar gasto"
                         Clicked="OnSaveClicked" />
              </VerticalStackLayout>
           </Border>

           <Button Text="Ver lista de gastos"
                  Clicked="OnGoToExpensesClicked"
                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                  TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />

           <Label x:Name="StatusLabel"
                 FontSize="13"
                 TextColor="Gray"
                 LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
       </RefreshView>

               <Grid x:Name="LoadingOverlay"
                             IsVisible="False"
                             BackgroundColor="#66000000"
                             InputTransparent="False">
                       <ActivityIndicator IsRunning="True"
                                                                      WidthRequest="52"
                                                                      HeightRequest="52"
                                                                      Color="White"
                                                                      HorizontalOptions="Center"
                                                                      VerticalOptions="Center" />
               </Grid>

        </Grid>

</ContentPage>
