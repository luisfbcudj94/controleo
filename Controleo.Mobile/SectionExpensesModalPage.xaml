<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Controleo.Mobile.Models"
             x:Class="Controleo.Mobile.SectionExpensesModalPage"
             Title="Detalle sección">

    <Grid Padding="16" RowSpacing="10" RowDefinitions="Auto,Auto,*">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Cerrar"
                    Clicked="OnCloseClicked"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
            <Label x:Name="SectionTitleLabel"
                   VerticalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="18" />
        </HorizontalStackLayout>

        <Label Grid.Row="1"
               x:Name="SummaryLabel"
               FontSize="13"
               TextColor="Gray" />

        <CollectionView Grid.Row="2"
                        x:Name="ExpensesBySectionCollection"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay gastos registrados en esta sección."
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:ExpenseItem">
                    <Border Padding="12"
                            Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Description}" FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='${0:N0}'}"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold" />
                            </Grid>
                            <Label Text="{Binding Date, StringFormat='Fecha: {0:yyyy-MM-dd}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                            <Label Text="{Binding PaymentMethod, StringFormat='Medio: {0}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
