<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{StaticResource AppBg}">

    <Grid Padding="10" RowSpacing="10" RowDefinitions="Auto,Auto,*,Auto,*">

        <Border Grid.Row="0" StrokeShape="RoundRectangle 16" Padding="8" StrokeThickness="0"
                BackgroundColor="{StaticResource PastelMint}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" WidthRequest="42" HeightRequest="42" CornerRadius="21"
                        BackgroundColor="{StaticResource White}" TextColor="{StaticResource AppText}"
                        FontAttributes="Bold" Clicked="OnPrevMonthClicked" />
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="MonthSelectorLabel" VerticalOptions="Center" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="{StaticResource AppText}" />
                        <Label Grid.Column="1" Text="▼" FontSize="10" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthSelectorTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="2" Text="▶" WidthRequest="42" HeightRequest="42" CornerRadius="21"
                        BackgroundColor="{StaticResource White}" TextColor="{StaticResource AppText}"
                        FontAttributes="Bold" Clicked="OnNextMonthClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="6" StrokeShape="RoundRectangle 14" StrokeThickness="0"
            BackgroundColor="{StaticResource White}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="CategoryModeButton" Text="Categorias" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="40"
                Clicked="OnCategoryModeClicked" />
            <Button Grid.Column="1" x:Name="PaymentModeButton" Text="Medios de pago" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="40"
                Clicked="OnPaymentModeClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="10" StrokeShape="RoundRectangle 18" StrokeThickness="0"
                BackgroundColor="{StaticResource White}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Grid WidthRequest="140" HeightRequest="140">
                            <GraphicsView x:Name="BudgetRingView" WidthRequest="140" HeightRequest="140" />
                            <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 50"
                                    BackgroundColor="{StaticResource White}" StrokeThickness="0"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label x:Name="RingPercentLabel" FontAttributes="Bold" FontSize="28"
                                           TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                                    <Label Text="USADO" FontSize="9" TextColor="{StaticResource AppHint}"
                                           HorizontalTextAlignment="Center" CharacterSpacing="1" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="PRESUPUESTO" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8"
                               TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                        <Label x:Name="BudgetSummaryLabel" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Grid WidthRequest="140" HeightRequest="140">
                            <GraphicsView x:Name="DistributionDonutView" WidthRequest="140" HeightRequest="140" />
                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 50" WidthRequest="70" HeightRequest="70"
                                        BackgroundColor="{StaticResource White}" StrokeThickness="0">
                                    <Label x:Name="DistributionCenterLabel" Text="Por tipo" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource AppHint}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                        <Label Text="DISTRIBUCIÓN" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8"
                               TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                           <Label x:Name="DistributionSummaryLabel" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center"
                               MaxLines="2" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <CollectionView Grid.Row="1" x:Name="DonutLegendCollection" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Spacing="6">
                                <Border WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5"
                                        BackgroundColor="{Binding DotColor}" StrokeThickness="0" VerticalOptions="Center" />
                                <Label Text="{Binding Label}" FontSize="11" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border StrokeShape="RoundRectangle 12" Padding="8" BackgroundColor="{StaticResource AppSurface2}" StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Disponible" FontSize="11" TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                            <Label x:Name="AvailableSummaryLabel" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="8" BackgroundColor="{StaticResource AppSurface2}" StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Presupuesto" FontSize="11" TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                            <Label x:Name="TotalBudgetSummaryLabel" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Padding="8" BackgroundColor="{StaticResource AppSurface2}" StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Gastado" FontSize="11" TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                            <Label x:Name="SpentSummaryLabel" FontSize="14" FontAttributes="Bold"
                                   TextColor="#E5534B" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Border>

         <Label Grid.Row="3" x:Name="SectionListTitleLabel" Text="CATEGORIAS" FontSize="12" FontAttributes="Bold"
                TextColor="{StaticResource AppHint}" CharacterSpacing="1.2" Margin="4,0,0,0" />

        <RefreshView Grid.Row="4" x:Name="DashboardRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="ChartCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay datos para mostrar." HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{StaticResource AppHint}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 16"
                                StrokeThickness="0" BackgroundColor="{Binding CardColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSectionTapped" CommandParameter="{Binding Key}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#88FFFFFF" StrokeThickness="0" VerticalOptions="Start">
                                    <Label Text="{Binding Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource AppText}" />
                                    <ProgressBar Progress="{Binding Ratio}" HeightRequest="6"
                                                 ProgressColor="{Binding ProgressColor}" />
                                    <Label Text="{Binding Subtitle}" FontSize="11"
                                           TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N0}'}"
                                       TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" FontSize="16"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="LoadingOverlay" Grid.RowSpan="5" IsVisible="False"
              BackgroundColor="#33000000" InputTransparent="False" Margin="-16">
            <ActivityIndicator IsRunning="True" WidthRequest="48" HeightRequest="48"
                               Color="{StaticResource Tertiary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Picker x:Name="MonthPicker" IsVisible="False" ItemDisplayBinding="{Binding Label}"
                SelectedIndexChanged="OnMonthPickerChanged" />
    </Grid>

</ContentPage>
