<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.DashboardPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray700}}"
                    Padding="14"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout>
                    <Label Text="Dashboard de gastos"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Visualiza gasto por sección y comparación contra presupuesto."
                           TextColor="White"
                           Opacity="0.9" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Recargar" Clicked="OnReloadClicked" />

            <Label x:Name="TotalsLabel"
                   FontAttributes="Bold"
                   FontSize="16" />

            <CollectionView x:Name="ChartCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay datos para mostrar en dashboard." HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding MovementType}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding ExpenseTotal, StringFormat='${0:N0}'}" TextColor="{StaticResource Primary}" />
                                </Grid>
                                <ProgressBar Progress="{Binding ExpenseRatio}" HeightRequest="10" />
                                <Grid ColumnDefinitions="*,*">
                                    <Label Text="{Binding BudgetTotal, StringFormat='Presupuesto: ${0:N0}'}" FontSize="12" TextColor="Gray" />
                                    <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding Balance, StringFormat='Balance: ${0:N0}'}" FontSize="12" TextColor="Gray" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
