<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.DashboardPage"
             Title="Dashboard">

    <Grid Padding="16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" StrokeShape="RoundRectangle 16" Padding="10" BackgroundColor="{StaticResource AppSurface}" Stroke="{StaticResource AppBorder}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" WidthRequest="42" HeightRequest="42" CornerRadius="21" Clicked="OnPrevMonthClicked" />
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="MonthSelectorLabel" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthSelectorTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="2" Text="▶" WidthRequest="42" HeightRequest="42" CornerRadius="21" Clicked="OnNextMonthClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="14" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource AppSurface}" Stroke="{StaticResource AppBorder}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Grid WidthRequest="130" HeightRequest="130" VerticalOptions="Center">
                    <GraphicsView x:Name="BudgetRingView"
                                  WidthRequest="130"
                                  HeightRequest="130" />
                    <VerticalStackLayout Spacing="0"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label x:Name="RingPercentLabel" FontAttributes="Bold" FontSize="34" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                        <Label Text="USADO" FontSize="11" TextColor="{StaticResource AppHint}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <CarouselView x:Name="SummaryCarousel"
                                  HeightRequest="130"
                                  Loop="True"
                                  IndicatorView="SummaryIndicator">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        Padding="12"
                                        Stroke="{StaticResource AppBorder}"
                                        BackgroundColor="{StaticResource AppSurface2}">
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="12" TextColor="{StaticResource AppHint}" />
                                        <Label Text="{Binding Value}"
                                               FontSize="26"
                                               FontAttributes="Bold"
                                               TextColor="{Binding AccentColor}" />
                                        <Label Text="Desliza para ver más"
                                               FontSize="11"
                                               TextColor="{StaticResource AppHint}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="SummaryIndicator"
                                   IndicatorColor="{StaticResource AppBorder}"
                                   SelectedIndicatorColor="{StaticResource PrimaryDark}"
                                   HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <Label Text="CATEGORÍAS" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppHint}" />
        </Grid>

         <RefreshView Grid.Row="3"
                     x:Name="DashboardRefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="ChartCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay datos para mostrar en dashboard."
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource AppSurface}" Stroke="{StaticResource AppBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSectionTapped"
                                                      CommandParameter="{Binding MovementType}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding MovementType}" FontAttributes="Bold" FontSize="17" />
                                    <Label Grid.Column="1" Text="{Binding ExpenseTotal, StringFormat='${0:N0}'}" TextColor="#B39DFA" FontAttributes="Bold" FontSize="18" />
                                </Grid>
                                <ProgressBar Progress="{Binding ExpenseRatio}" HeightRequest="8" ProgressColor="{Binding ProgressColor}" />
                                <Grid ColumnDefinitions="*,*">
                                    <Label Text="{Binding BudgetLabel}" FontSize="13" TextColor="{StaticResource AppHint}" />
                                    <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding Balance, StringFormat='Balance: ${0:N0}'}" FontSize="13" TextColor="{Binding BalanceColor}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#66000000"
              InputTransparent="False"
              Margin="-16">
            <ActivityIndicator IsRunning="True"
                       WidthRequest="52"
                       HeightRequest="52"
                       Color="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
        </Grid>

                <Picker x:Name="MonthPicker"
                    IsVisible="False"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedIndexChanged="OnMonthPickerChanged" />
    </Grid>

</ContentPage>
