<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Controleo.Mobile.Models"
             x:Class="Controleo.Mobile.BudgetsPage"
             Title="Presupuestos">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">
        <Border StrokeShape="RoundRectangle 12" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" WidthRequest="44" Clicked="OnPrevMonthClicked" />
                <Picker Grid.Column="1"
                        x:Name="MonthPicker"
                        Title="Mes"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedIndexChanged="OnMonthPickerChanged" />
                <Button Grid.Column="2" Text="▶" WidthRequest="44" Clicked="OnNextMonthClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Configurar presupuesto por sección" FontAttributes="Bold" FontSize="18" />
                <Picker x:Name="MovementTypePicker" Title="Sección" />
                <Entry x:Name="AmountEntry" Placeholder="Valor presupuesto" Keyboard="Numeric" />
                <Button x:Name="SaveBudgetButton" Text="Guardar presupuesto" Clicked="OnSaveBudgetClicked" />
                <Label x:Name="StatusLabel" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="2"
                     x:Name="BudgetsRefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="BudgetsCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay presupuestos configurados." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:BudgetItem">
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding MovementType}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Amount, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" FontSize="12" TextColor="Gray" Text="{Binding UpdatedAt, StringFormat='Actualizado: {0:yyyy-MM-dd HH:mm}'}" />
                                <Button Grid.Row="1" Grid.Column="1"
                                        Text="Eliminar"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                        CommandParameter="{Binding MovementType}"
                                        Clicked="OnDeleteBudgetClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#66000000"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                       WidthRequest="52"
                       HeightRequest="52"
                       Color="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
