<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Controleo.Mobile.Models"
             x:Class="Controleo.Mobile.BudgetsPage"
             Title="Presupuestos">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">
        <Border StrokeShape="RoundRectangle 12" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" WidthRequest="44" Clicked="OnPrevMonthClicked" />
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="MonthSelectorLabel" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthSelectorTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="2" Text="▶" WidthRequest="44" Clicked="OnNextMonthClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Configurar presupuesto global por sección" FontAttributes="Bold" FontSize="18" />
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AppSurface2}" Stroke="{StaticResource AppBorder}" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="MovementTypeSelectorLabel" VerticalOptions="Center" Text="Seleccionar sección" />
                        <Label Grid.Column="1" Text="▼" FontSize="11" TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMovementTypeSelectorTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Entry x:Name="AmountEntry" Placeholder="Valor presupuesto" Keyboard="Numeric" />
                <ImageButton x:Name="SaveBudgetButton"
                             Source="bi_floppy.svg"
                             WidthRequest="44"
                             HeightRequest="44"
                         HorizontalOptions="Start"
                             CornerRadius="8"
                             Padding="7"
                             BackgroundColor="{StaticResource ActionSave}"
                         SemanticProperties.Description="Guardar presupuesto"
                         Clicked="OnSaveBudgetClicked" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="2"
                     x:Name="BudgetsRefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="BudgetsCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay presupuestos configurados." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:BudgetItem">
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding MovementType}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Amount, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" FontSize="12" TextColor="{StaticResource AppHint}" Text="{Binding UpdatedAt, StringFormat='Actualizado: {0:yyyy-MM-dd HH:mm}'}" />
                                <ImageButton Grid.RowSpan="2" Grid.Column="2"
                                             Source="bi_trash.svg"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             CornerRadius="8"
                                             Padding="6"
                                             BackgroundColor="{StaticResource ActionDelete}"
                                             HorizontalOptions="End"
                                             VerticalOptions="Center"
                                         SemanticProperties.Description="Eliminar presupuesto"
                                         CommandParameter="{Binding MovementType}"
                                         Clicked="OnDeleteBudgetClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#66000000"
              InputTransparent="False"
              Margin="-16">
            <ActivityIndicator IsRunning="True"
                       WidthRequest="52"
                       HeightRequest="52"
                       Color="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
        </Grid>

                <Picker x:Name="MonthPicker"
                    IsVisible="False"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedIndexChanged="OnMonthPickerChanged" />

                <Picker x:Name="MovementTypePicker"
                    IsVisible="False" />
    </Grid>

</ContentPage>
