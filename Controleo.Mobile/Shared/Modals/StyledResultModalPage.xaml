<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.Shared.Modals.StyledResultModalPage"
             BackgroundColor="#44000000"
             Padding="20">
    <Grid>
        <Border x:Name="CardBorder" Padding="18" StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}" Stroke="{StaticResource AppBorder}"
                VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="420">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border x:Name="IconCircle" WidthRequest="44" HeightRequest="44"
                            StrokeShape="RoundRectangle 22" HorizontalOptions="Start" VerticalOptions="Center">
                        <Label x:Name="IconLabel" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="TitleLabel" FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource AppText}" />
                        <Label x:Name="MessageLabel" FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{StaticResource AppHint}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="✕" WidthRequest="34" HeightRequest="34" CornerRadius="17"
                            FontSize="14" Padding="0" Clicked="OnCloseClicked"
                            BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource AppText}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
