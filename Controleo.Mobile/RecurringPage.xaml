<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controleo.Mobile.RecurringPage"
             Title="Recurrentes"
             BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Gastos recurrentes" FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource AppText}" />

                <!-- Info Card -->
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14"
                        BackgroundColor="{StaticResource AccentLight}">
                    <Border.Stroke>
                        <LinearGradientBrush>
                            <GradientStop Color="{StaticResource Primary}" Offset="0" />
                            <GradientStop Color="{StaticResource AccentLight}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="🔄" FontSize="24" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="¿Cómo funcionan?" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="Los gastos recurrentes se registran automáticamente cada mes en el día que configures. Ideal para arriendo, suscripciones, cuotas y pagos fijos."
                                   FontSize="12" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Add Button -->
                <Button Text="➕ Agregar gasto recurrente"
                        FontAttributes="Bold" FontSize="16"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        CornerRadius="16" HeightRequest="52"
                        Clicked="OnAddNewClicked" />

                <Label x:Name="StatusLabel" TextColor="{StaticResource AppHint}" FontSize="12" />

                <!-- List -->
                <CollectionView x:Name="RecurringCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0" Padding="14"
                                    Margin="0,0,0,8" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource White}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <!-- Icon -->
                                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IconColor}" StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Body -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="14"
                                               TextColor="{StaticResource AppText}" />
                                        <Label FontSize="11" TextColor="{StaticResource AppHint}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding MovementType}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding PaymentMethod}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Right: amount + day + actions -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='${0:N0}'}"
                                               FontAttributes="Bold" FontSize="15"
                                               TextColor="{StaticResource PrimaryDark}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding DayOfMonth, StringFormat='Día {0}'}"
                                               FontSize="11" TextColor="{StaticResource AppHint}"
                                               HorizontalTextAlignment="End" />
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                            <Border StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{StaticResource AccentLight}" StrokeThickness="0"
                                                    WidthRequest="28" HeightRequest="28" Padding="0">
                                                <Label Text="✏️" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnEditTapped" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <Border StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="#FFE0E0" StrokeThickness="0"
                                                    WidthRequest="28" HeightRequest="28" Padding="0">
                                                <Label Text="🗑️" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnDeleteTapped" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Add/Edit Form Modal Overlay -->
        <Grid x:Name="FormOverlay" Grid.Row="0" IsVisible="False"
              BackgroundColor="#44000000" InputTransparent="False" ZIndex="20" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="24">
                <Border StrokeShape="RoundRectangle 20" Padding="18"
                        BackgroundColor="{StaticResource White}" Stroke="{StaticResource AppBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="FormTitle" Text="Nuevo gasto recurrente"
                                   FontSize="18" FontAttributes="Bold" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                                    CornerRadius="18" BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource AppText}" FontSize="14"
                                    Clicked="OnCancelForm" />
                        </Grid>
                        <Label Text="Descripción" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                        <Entry x:Name="DescriptionEntry" Placeholder="Ej: Arriendo" MaxLength="100" />

                        <Label Text="Monto" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                        <Entry x:Name="AmountEntry" Placeholder="$0" Keyboard="Numeric" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Tipo de gasto" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource AppSurface2}"
                                        Stroke="{StaticResource AppBorder}" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label x:Name="SelectedTypeLabel" Text="Seleccionar"
                                               VerticalOptions="Center" TextColor="{StaticResource AppText}" FontSize="13" />
                                        <Label Grid.Column="1" Text="▼" FontSize="10"
                                               TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTypePickerTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Medio de pago" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource AppSurface2}"
                                        Stroke="{StaticResource AppBorder}" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label x:Name="SelectedPayLabel" Text="Seleccionar"
                                               VerticalOptions="Center" TextColor="{StaticResource AppText}" FontSize="13" />
                                        <Label Grid.Column="1" Text="▼" FontSize="10"
                                               TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPayPickerTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Día del mes" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                                <Entry x:Name="DayEntry" Placeholder="1" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Fecha inicio" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource AppHint}" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource AppSurface2}"
                                        Stroke="{StaticResource AppBorder}" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label x:Name="StartDateSelectorLabel" VerticalOptions="Center"
                                               TextColor="{StaticResource AppText}" FontSize="13" />
                                        <Label Grid.Column="1" Text="▼" FontSize="10"
                                               TextColor="{StaticResource AppHint}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStartDateSelectorTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="IsActiveCheck" IsChecked="True" />
                            <Label Text="Activo" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button Text="Guardar" Clicked="OnSaveClicked"
                                    x:Name="SaveButton"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource PrimaryDarkText}"
                                    CornerRadius="14" HeightRequest="48" FontAttributes="Bold" />
                            <Button Grid.Column="1" Text="Cancelar" Clicked="OnCancelForm"
                                    BackgroundColor="{StaticResource AppSurface2}"
                                    TextColor="{StaticResource AppText}"
                                    CornerRadius="14" HeightRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
        <!-- Type Picker Overlay -->
        <Grid x:Name="TypePickerOverlay" Grid.Row="0" IsVisible="False"
              BackgroundColor="#55000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="24">
                <Border StrokeShape="RoundRectangle 20" Padding="18"
                        BackgroundColor="{StaticResource White}" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tipo de gasto" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                                    CornerRadius="18" BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource AppText}" FontSize="14"
                                    Clicked="OnCloseTypePicker" Padding="0" />
                        </Grid>
                        <FlexLayout x:Name="TypePickerFlexLayout"
                                    Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Payment Picker Overlay -->
        <Grid x:Name="PayPickerOverlay" Grid.Row="0" IsVisible="False"
              BackgroundColor="#55000000" InputTransparent="False" ZIndex="30" Margin="-16">
            <ScrollView VerticalOptions="Center" Margin="24">
                <Border StrokeShape="RoundRectangle 20" Padding="18"
                        BackgroundColor="{StaticResource White}" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Medio de pago" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
                            <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                                    CornerRadius="18" BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource AppText}" FontSize="14"
                                    Clicked="OnClosePayPicker" Padding="0" />
                        </Grid>
                        <FlexLayout x:Name="PayPickerFlexLayout"
                                    Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>
