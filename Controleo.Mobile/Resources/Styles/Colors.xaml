<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════════════════
         Controleo v2 — Lite / Minimal White
         Inspiration: Revolut, Mint, Linear, Monzo
         ═══════════════════════════════════════════════════════ -->

    <!-- Accent — soft sage green -->
    <Color x:Key="Primary">#2D6A4F</Color>
    <Color x:Key="PrimaryDark">#1B4332</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#B7E4C7</Color>
    <Color x:Key="SecondaryDarkText">#2D6A4F</Color>
    <Color x:Key="Tertiary">#40916C</Color>
    <Color x:Key="Accent">#40916C</Color>
    <Color x:Key="AccentLight">#D8F3DC</Color>

    <!-- Pastels — exactly 4 for card backgrounds by movement type -->
    <Color x:Key="PastelMint">#D8F3DC</Color>
    <Color x:Key="PastelSky">#D4EAFF</Color>
    <Color x:Key="PastelPeach">#FFE5D4</Color>
    <Color x:Key="PastelLavender">#E8DEFF</Color>

    <!-- Buttons -->
    <Color x:Key="BtnSecondaryBg">#B7E4C7</Color>
    <Color x:Key="BtnSecondaryText">#1B4332</Color>

    <!-- Surfaces — warm off-white with hint of sage -->
    <Color x:Key="AppBg">#F4F7F5</Color>
    <Color x:Key="AppSurface">#FFFFFF</Color>
    <Color x:Key="AppSurface2">#EFF3F1</Color>
    <Color x:Key="AppBorder">#DCE5DF</Color>
    <Color x:Key="AppText">#1A2E23</Color>
    <Color x:Key="AppHint">#7A9183</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="ActionDelete">#E5534B</Color>
    <Color x:Key="ActionEdit">#5B8DEF</Color>
    <Color x:Key="ActionSave">#40916C</Color>
    <Color x:Key="MidnightBlue">#1A2E23</Color>
    <Color x:Key="OffBlack">#F4F7F5</Color>

    <!-- Grays — slightly warm -->
    <Color x:Key="Gray100">#F2F5F3</Color>
    <Color x:Key="Gray200">#E4EAE6</Color>
    <Color x:Key="Gray300">#D0D9D3</Color>
    <Color x:Key="Gray400">#A8B8AE</Color>
    <Color x:Key="Gray500">#7A918A</Color>
    <Color x:Key="Gray600">#5A6E63</Color>
    <Color x:Key="Gray700">#3D5147</Color>
    <Color x:Key="Gray900">#1F3029</Color>
    <Color x:Key="Gray950">#142019</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>